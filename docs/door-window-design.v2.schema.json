{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doormes.local/schemas/door-window-design.v2.schema.json",
  "title": "朗科门窗设计大师设计JSON",
  "description": "中国门窗可视化设计平台第二版设计数据格式。保留规则网格，并增加稳定区域ID、框段、局部中梃、项目级拼接料与转角料、多窗组合、三维定位及安装包套。",
  "type": "object",
  "required": ["schemaVersion", "project", "order", "catalog", "windows", "joints", "assemblies"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "cn-door-window-design.v2"
    },
    "project": {
      "type": "object",
      "required": ["projectId", "name"],
      "properties": {
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "customerName": { "type": "string" },
        "address": { "type": "string" }
      },
      "additionalProperties": true
    },
    "order": {
      "type": "object",
      "required": ["orderId"],
      "properties": {
        "orderId": { "type": "string" },
        "batchNo": { "type": "string" },
        "source": { "type": "string" },
        "externalOrderId": { "type": "string" },
        "productionAllowed": { "type": "boolean" },
        "shipmentAllowed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "catalog": {
      "type": "object",
      "required": ["profileSystems", "glassTypes", "hardwareSets", "panelTypes"],
      "properties": {
        "profileSystems": {
          "type": "array",
          "items": { "$ref": "#/$defs/profileSystem" }
        },
        "glassTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/glassType" }
        },
        "hardwareSets": {
          "type": "array",
          "items": { "$ref": "#/$defs/hardwareSet" }
        },
        "panelTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/panelType" }
        }
      },
      "additionalProperties": true
    },
    "componentLibrary": {
      "type": "array",
      "items": { "$ref": "#/$defs/componentTemplate" }
    },
    "customShapes": {
      "type": "array",
      "description": "用户在DIY异型构件画布中保存的可复用窗格轮廓。",
      "items": { "$ref": "#/$defs/customShapeElement" }
    },
    "viewOptions": { "$ref": "#/$defs/viewOptions" },
    "calculation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "calculated", "confirmed", "frozen", "changed"]
        },
        "mbomVersion": { "type": "integer", "minimum": 0 },
        "lastCalculatedAt": { "type": "string" },
        "confirmedAt": { "type": "string" },
        "frozenAt": { "type": "string" },
        "lastHash": { "type": "string" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/integrationEvent" }
        }
      },
      "additionalProperties": true
    },
    "integrations": {
      "type": "object",
      "properties": {
        "reservedEvents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system": { "type": "string" },
              "type": { "type": "string" },
              "id": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/windowDesign" }
    },
    "joints": {
      "type": "array",
      "description": "项目级工程连接节点。节点可以连接多樘窗，但由hostWindowId指定唯一BOM归属，防止重复计料。",
      "items": { "$ref": "#/$defs/engineeringJoint" }
    },
    "assemblies": {
      "type": "array",
      "description": "项目级多窗组合。根窗建立局部坐标系，其他窗体按停靠关系或毫米坐标定位；连接节点仍由joints统一管理。",
      "items": { "$ref": "#/$defs/windowAssembly" }
    }
  },
  "$defs": {
    "profileSystem": {
      "type": "object",
      "required": ["id", "name", "material", "frameProfile", "sashProfile", "mullionProfile"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "material": {
          "type": "string",
          "enum": ["aluminum", "pvc", "wood", "wood_aluminum", "steel"]
        },
        "frameProfile": { "type": "string" },
        "sashProfile": { "type": "string" },
        "mullionProfile": { "type": "string" },
        "spliceProfile": { "type": "string" },
        "cornerProfile": { "type": "string" },
        "beadProfile": { "type": "string" },
        "gasketCode": { "type": "string" },
        "faceWidthMm": { "type": "number", "minimum": 1 },
        "frameDepthMm": { "type": "number", "minimum": 1 },
        "sashFaceWidthMm": { "type": "number", "minimum": 1 },
        "stockLengthMm": { "type": "number", "minimum": 1 },
        "sawKerfMm": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "glassType": {
      "type": "object",
      "required": ["id", "name", "thicknessMm"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "thicknessMm": { "type": "number", "minimum": 1 },
        "ug": { "type": "number" }
      },
      "additionalProperties": true
    },
    "hardwareSet": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handleCode": { "type": "string" },
        "hingeCode": { "type": "string" },
        "memberName": { "type": "string" },
        "hingeQtyRule": { "type": "string" }
      },
      "additionalProperties": true
    },
    "panelType": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "thicknessMm": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "componentTemplate": {
      "type": "object",
      "required": ["id", "name", "window"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "source": { "type": "string" },
        "window": { "$ref": "#/$defs/windowTemplate" }
      },
      "additionalProperties": true
    },
    "windowTemplate": {
      "type": "object",
      "required": ["layout"],
      "properties": {
        "widthMm": { "type": "number", "minimum": 300 },
        "heightMm": { "type": "number", "minimum": 300 },
        "installation": { "$ref": "#/$defs/installation" },
        "shape": { "$ref": "#/$defs/shape" },
        "geometryMode": { "$ref": "#/$defs/geometryMode" },
        "layout": { "$ref": "#/$defs/layoutGrid" },
        "topology": { "$ref": "#/$defs/topology" },
        "seriesId": { "type": "string" },
        "colorInside": { "type": "string" },
        "colorOutside": { "type": "string" },
        "defaultGlassTypeId": { "type": "string" },
        "defaultHardwareSetId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "windowDesign": {
      "type": "object",
      "required": ["windowId", "mark", "quantity", "widthMm", "heightMm", "seriesId", "geometryMode", "layout", "topology"],
      "properties": {
        "windowId": { "type": "string" },
        "mark": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "widthMm": { "type": "number", "minimum": 300 },
        "heightMm": { "type": "number", "minimum": 300 },
        "floor": { "type": "string" },
        "room": { "type": "string" },
        "seriesId": { "type": "string" },
        "colorInside": { "type": "string" },
        "colorOutside": { "type": "string" },
        "defaultGlassTypeId": { "type": "string" },
        "defaultHardwareSetId": { "type": "string" },
        "installation": { "$ref": "#/$defs/installation" },
        "shape": { "$ref": "#/$defs/shape" },
        "geometryMode": { "$ref": "#/$defs/geometryMode" },
        "layout": { "$ref": "#/$defs/layoutGrid" },
        "topology": { "$ref": "#/$defs/topology" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "shape": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["rectangular", "arched", "trapezoid", "trapezoid_left", "trapezoid_peak", "notch_top_left", "notch_top_right", "custom_polygon", "round", "polygon"]
        },
        "archHeightMm": { "type": "number", "minimum": 0 },
        "polygonPoints": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": true
    },
    "installation": {
      "type": "object",
      "properties": {
        "sillHeightMm": { "type": "number", "minimum": 0 },
        "surround": { "$ref": "#/$defs/installationSurround" }
      },
      "additionalProperties": true
    },
    "installationSurround": {
      "type": "object",
      "description": "整樘门窗的洞口包套与衬板参数，不属于窗格或开启扇。",
      "required": ["enabled", "mountingMode", "frameAlignment", "styleId", "edgeMode", "sides", "wallThicknessMm", "wallMaterialId", "wallCornerMode", "cornerPierWidthMm", "frameOffsetMm", "exteriorMountGapMm", "outsideWidthMm", "insideWidthMm", "boardThicknessMm", "materialCode", "colorOutside", "colorInside"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mountingMode": {
          "type": "string",
          "description": "门窗与墙体的安装关系。opening表示安装在洞口进深内；exterior_overmount表示整框位于外墙完成面之外。",
          "enum": ["opening", "exterior_overmount"]
        },
        "frameAlignment": {
          "type": "string",
          "description": "洞口内安装的框位基准。",
          "enum": ["center", "exterior_flush", "interior_flush", "custom"]
        },
        "styleId": {
          "type": "string",
          "enum": ["both_sides", "outside_only", "inside_only", "liner"]
        },
        "edgeMode": {
          "type": "string",
          "enum": ["all", "three_without_bottom", "left_top", "right_top", "custom"]
        },
        "sides": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["top", "right", "bottom", "left"] }
        },
        "wallThicknessMm": { "type": "number", "minimum": 60, "maximum": 600 },
        "wallMaterialId": {
          "type": "string",
          "description": "洞口宿主墙体的完成面材质，用于安装环境表达和三维预览，不计入门窗产品BOM。",
          "enum": ["plaster", "concrete", "red_brick", "gray_brick", "stone"]
        },
        "wallCornerMode": {
          "type": "string",
          "description": "宿主墙在门窗转角处的结构。structural_pier表示两面墙由结构墙柱连续连接；open_corner表示经结构确认的连续转角洞口。该字段独立于窗系统cornerPostMode。",
          "enum": ["structural_pier", "open_corner"]
        },
        "cornerPierWidthMm": {
          "type": "number",
          "description": "结构转角墙柱沿两面墙分别占用的长度；它位于主窗洞口终点与回墙窗洞口起点之间，不占用门窗净宽。",
          "minimum": 120,
          "maximum": 1200
        },
        "frameOffsetMm": {
          "type": "number",
          "description": "自定义框中心相对墙厚中心的偏移；正值向室内，负值向室外。仅frameAlignment=custom时生效。",
          "minimum": -300,
          "maximum": 300
        },
        "exteriorMountGapMm": {
          "type": "number",
          "description": "外挂安装时窗框内表面与外墙完成面之间的净间隙。",
          "minimum": 0,
          "maximum": 200
        },
        "outsideWidthMm": { "type": "number", "minimum": 0, "maximum": 500 },
        "insideWidthMm": { "type": "number", "minimum": 0, "maximum": 500 },
        "boardThicknessMm": { "type": "number", "minimum": 5, "maximum": 100 },
        "materialCode": { "type": "string" },
        "colorOutside": { "type": "string" },
        "colorInside": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "viewOptions": {
      "type": "object",
      "description": "仅控制设计图显示，不参与算料和BOM计算。",
      "properties": {
        "showOpenState": { "type": "boolean" },
        "showProfileColor": { "type": "boolean" },
        "showDimensions": { "type": "boolean" },
        "showPlanView": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "layoutGrid": {
      "type": "object",
      "required": ["columns", "rows", "cells"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cell" }
        }
      },
      "additionalProperties": true
    },
    "geometryMode": {
      "type": "string",
      "description": "grid表示纯规则分格，topology表示规则网格上叠加了局部框梃或自由节点。",
      "enum": ["grid", "topology"]
    },
    "topology": {
      "type": "object",
      "description": "门窗几何拓扑。坐标使用框内区域的0-1归一化坐标，缩放整窗时无需重写节点。",
      "required": ["coordinateSystem", "vertices", "frameSegments", "members", "regions"],
      "properties": {
        "coordinateSystem": { "type": "string", "const": "normalized-inner" },
        "vertices": {
          "type": "array",
          "items": { "$ref": "#/$defs/topologyVertex" }
        },
        "frameSegments": {
          "type": "array",
          "items": { "$ref": "#/$defs/frameSegment" }
        },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/topologyMember" }
        },
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/topologyRegion" }
        }
      },
      "additionalProperties": true
    },
    "topologyVertex": {
      "type": "object",
      "required": ["vertexId", "xRatio", "yRatio"],
      "properties": {
        "vertexId": { "type": "string" },
        "xRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "yRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "frameSegment": {
      "type": "object",
      "required": ["segmentId", "startVertexId", "endVertexId", "profileRole"],
      "properties": {
        "segmentId": { "type": "string" },
        "side": { "type": "string", "enum": ["top", "right", "bottom", "left", "free"] },
        "startVertexId": { "type": "string" },
        "endVertexId": { "type": "string" },
        "profileRole": { "type": "string", "enum": ["frame", "door-frame", "free-frame"] },
        "profileId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "topologyMember": {
      "type": "object",
      "required": ["memberId", "role", "orientation", "hostRegionId", "positionRatio", "span", "throughMode", "connectionStart", "connectionEnd"],
      "properties": {
        "memberId": { "type": "string" },
        "role": { "type": "string", "const": "mullion" },
        "orientation": { "type": "string", "enum": ["vertical", "horizontal"] },
        "hostRegionId": { "type": "string" },
        "positionRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "span": {
          "type": "object",
          "required": ["startRatio", "endRatio"],
          "properties": {
            "startRatio": { "type": "number", "minimum": 0, "maximum": 1 },
            "endRatio": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "profileId": { "type": "string" },
        "throughMode": { "type": "string", "enum": ["local", "continuous"] },
        "connectionStart": { "type": "string", "enum": ["butt", "through"] },
        "connectionEnd": { "type": "string", "enum": ["butt", "through"] },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "topologyRegion": {
      "type": "object",
      "required": ["regionId", "source", "row", "col"],
      "properties": {
        "regionId": { "type": "string" },
        "source": { "type": "string", "enum": ["layout-cell", "free-region"] },
        "row": { "type": "integer", "minimum": 0 },
        "col": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "engineeringJoint": {
      "type": "object",
      "description": "窗与窗、窗与结构之间的拼接或转角连接。span按宿主窗边长使用0-1归一化坐标。",
      "required": ["jointId", "type", "style", "orientation", "hostWindowId", "hostEdge", "connectedWindowIds", "angleDeg", "legWidthAMm", "legWidthBMm", "span", "profileId", "frameTreatment", "postMode", "fastenerSpacingMm"],
      "properties": {
        "jointId": { "type": "string" },
        "type": { "type": "string", "enum": ["splice", "corner"] },
        "style": { "type": "string", "enum": ["flat", "reinforced", "default", "curved", "universal", "rectangular"] },
        "orientation": { "type": "string", "enum": ["normal", "reversed"] },
        "hostWindowId": { "type": "string" },
        "hostEdge": { "type": "string", "enum": ["left", "right", "top", "bottom"] },
        "connectedWindowIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "angleDeg": { "type": "number", "minimum": 60, "maximum": 180 },
        "legWidthAMm": { "type": "number", "minimum": 10, "maximum": 300 },
        "legWidthBMm": { "type": "number", "minimum": 10, "maximum": 300 },
        "span": {
          "type": "object",
          "required": ["startRatio", "endRatio"],
          "properties": {
            "startRatio": { "type": "number", "minimum": 0, "maximum": 1 },
            "endRatio": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "profileId": { "type": "string" },
        "frameTreatment": { "type": "string", "enum": ["keep_both", "shared_frame", "connector_only"] },
        "postMode": { "type": "string", "enum": ["profile", "postless"] },
        "fastenerSpacingMm": { "type": "number", "minimum": 100, "maximum": 1000 },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "windowAssembly": {
      "type": "object",
      "description": "由一樘根窗和若干定位窗组成的工程组合，供2D排布、3D预览、组合BOM和外部接口共同使用。",
      "required": ["assemblyId", "name", "rootWindowId", "placements"],
      "properties": {
        "assemblyId": { "type": "string" },
        "name": { "type": "string" },
        "rootWindowId": { "type": "string" },
        "placements": {
          "type": "array",
          "items": { "$ref": "#/$defs/assemblyPlacement" }
        },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "assemblyPlacement": {
      "type": "object",
      "description": "一樘定位窗相对已定位参考窗的装配关系。自由定位时使用freePosition，其余方式由dock、align、gapMm和offsetMm推导坐标。",
      "required": ["placementId", "windowId", "referenceWindowId", "dock", "align", "gapMm", "offsetMm", "rotationDeg", "freePosition", "jointId"],
      "properties": {
        "placementId": { "type": "string" },
        "windowId": { "type": "string" },
        "referenceWindowId": { "type": "string" },
        "dock": {
          "type": "string",
          "enum": ["left", "right", "top", "bottom", "free"]
        },
        "align": {
          "type": "string",
          "enum": ["start", "center", "end"]
        },
        "gapMm": { "type": "number", "minimum": 0, "maximum": 2000 },
        "offsetMm": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "rotationDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "freePosition": {
          "type": "object",
          "required": ["xMm", "yMm", "zMm"],
          "properties": {
            "xMm": { "type": "number", "minimum": -50000, "maximum": 50000 },
            "yMm": { "type": "number", "minimum": -50000, "maximum": 50000 },
            "zMm": { "type": "number", "minimum": -50000, "maximum": 50000 }
          },
          "additionalProperties": false
        },
        "jointId": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "shapePoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 100 },
        "y": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "customShapeElement": {
      "type": "object",
      "required": ["shapeId", "name", "points"],
      "properties": {
        "shapeId": { "type": "string" },
        "name": { "type": "string" },
        "windowId": { "type": "string" },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/shapePoint" }
        },
        "createdAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "cellCustomShape": {
      "type": "object",
      "required": ["name", "points"],
      "properties": {
        "shapeId": { "type": "string" },
        "name": { "type": "string" },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/shapePoint" }
        }
      },
      "additionalProperties": true
    },
    "cell": {
      "type": "object",
      "required": ["cellId", "type"],
      "properties": {
        "cellId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["fixed_glass", "turn", "turn_tilt", "top_hung", "bottom_hung", "sliding", "lift_slide", "psk", "parallel_slide", "parallel_project", "pocket_slide", "corner_slide", "vertical_slide", "folding", "door", "screen", "louver", "grille", "panel", "empty"]
        },
        "opening": {
          "type": "string",
          "description": "构件开启方向稳定编码；固定构件使用 fixed。",
          "enum": ["fixed", "left_in", "right_in", "left_out", "right_out", "top_in", "top_out", "bottom_in", "bottom_out", "slide_left", "slide_right", "lift_slide_left", "lift_slide_right", "psk_left", "psk_right", "parallel_slide_left", "parallel_slide_right", "parallel_out", "pocket_left", "pocket_right", "pocket_both", "corner_left", "corner_right", "corner_both", "slide_up", "slide_down", "fold_left", "fold_right"]
        },
        "openingAssembly": { "$ref": "#/$defs/openingAssembly" },
        "customShape": { "$ref": "#/$defs/cellCustomShape" },
        "glassTypeId": { "type": "string" },
        "hardwareSetId": { "type": "string" },
        "panelTypeId": { "type": "string" },
        "handleHeightMm": { "type": "number", "minimum": 0 },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "openingAssembly": {
      "type": "object",
      "description": "组合开启构件的生产语义。opening描述基本方向，本对象描述扇数、活动扇、轨道、主从顺序、收口和配套纱窗。",
      "required": ["mechanism", "panelCount", "activePanelCount", "trackCount", "stackSide", "primarySide", "openPlane", "panels", "operationSequence"],
      "properties": {
        "mechanism": {
          "type": "string",
          "enum": ["fixed", "side_hung", "tilt_turn", "top_hung", "bottom_hung", "inline_slide", "lift_slide", "psk_tilt_slide", "parallel_slide", "parallel_project", "pocket_slide", "corner_slide", "vertical_slide", "folding"]
        },
        "panelCount": { "type": "integer", "minimum": 1, "maximum": 12 },
        "activePanelCount": { "type": "integer", "minimum": 0, "maximum": 12 },
        "trackCount": { "type": "integer", "minimum": 1, "maximum": 4 },
        "stackSide": {
          "type": "string",
          "enum": ["none", "left", "right", "both", "top", "bottom"]
        },
        "primarySide": {
          "type": "string",
          "enum": ["left", "right"]
        },
        "mullionMode": {
          "type": "string",
          "enum": ["fixed_mullion", "flying_mullion"]
        },
        "openPlane": {
          "type": "string",
          "enum": ["in", "out"]
        },
        "operationPriority": {
          "type": "string",
          "enum": ["turn_first", "tilt_first", "slide_first"]
        },
        "ventilationMode": {
          "type": "string",
          "enum": ["none", "tilt", "micro", "night"]
        },
        "trafficDoor": {
          "type": "string",
          "enum": ["none", "left", "right"]
        },
        "screenMode": {
          "type": "string",
          "enum": ["none", "fixed", "swing", "sliding", "retractable"]
        },
        "cornerAngleDeg": { "type": "number", "minimum": 60, "maximum": 180 },
        "cornerPostMode": {
          "type": "string",
          "enum": ["post", "postless"]
        },
        "pocketDepthMm": { "type": "integer", "minimum": 0, "maximum": 4000 },
        "panels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/openingPanel" }
        },
        "operationSequence": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "openingPanel": {
      "type": "object",
      "required": ["id", "label", "role", "movable", "hingeSide", "trackIndex", "operationOrder"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["primary", "secondary", "fixed"]
        },
        "movable": { "type": "boolean" },
        "hingeSide": {
          "type": "string",
          "enum": ["left", "right"]
        },
        "trackIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
        "operationOrder": { "type": "integer", "minimum": -1, "maximum": 11 }
      },
      "additionalProperties": true
    },
    "integrationEvent": {
      "type": "object",
      "required": ["type", "at"],
      "properties": {
        "type": { "type": "string" },
        "at": { "type": "string" },
        "mbomVersion": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
